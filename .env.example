# --- Clerk (auth + organizations) ---
# From clerk.com dashboard after creating an application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Neon Postgres) ---
# From neon.tech dashboard, "Connection string"
DATABASE_URL=

# --- Vault encryption ---
# Generate with: openssl rand -hex 32 (do this once, keep it secret, never commit it)
VAULT_ENCRYPTION_KEY=
